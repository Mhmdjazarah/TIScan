# ============================================================================
# TIScan configuration. Copy this file to .env and fill in the keys you have.
# Every key is FREE. TIScan works without any key (21 sources), and each key
# you add unlocks or upgrades a source. Restart TIScan after editing.
# ============================================================================

# --- Most important (free) ----------------------------------------------------
# VirusTotal - https://www.virustotal.com/gui/join-us  (free: 4 lookups/min, 500/day)
VT_API_KEY=
# AbuseIPDB - https://www.abuseipdb.com/register  (free: 1000 checks/day)
ABUSEIPDB_API_KEY=
# abuse.ch (one key for URLhaus + ThreatFox + MalwareBazaar) - https://auth.abuse.ch/
ABUSECH_API_KEY=

# --- Optional (sources work without a key; a key raises limits / adds data) ---
# AlienVault OTX - https://otx.alienvault.com  (adds passive DNS for pivoting)
OTX_API_KEY=
# Shodan - https://account.shodan.io  (without key: free InternetDB)
SHODAN_API_KEY=
GREYNOISE_API_KEY=
PULSEDIVE_API_KEY=
URLSCAN_API_KEY=
IPINFO_TOKEN=
# Have I Been Pwned (paid) - https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- MISP (optional) - push scan results as MISP events -------------------------
MISP_URL=
MISP_KEY=
MISP_VERIFY_SSL=true
# 0 = your organisation only, 1 = this community, 2 = connected, 3 = all
MISP_DISTRIBUTION=0
MISP_TLP=tlp:amber

# --- Continuous monitoring & alerts ----------------------------------------------
# Easiest: set these from the dashboard (Monitoring tab -> Email alerts).
MONITOR_ENABLED=true
MONITOR_INTERVAL_HOURS=24
# Send a summary of existing findings the first time an asset is checked
MONITOR_NOTIFY_BASELINE=true
# Also email a status report after every scheduled check, even when nothing new was found
MONITOR_DAILY_REPORT=false
# Alerts are sent by email (SMTP). Gmail: smtp.gmail.com / 587 / starttls,
# SMTP_USER = your Gmail address, SMTP_PASSWORD = a 16-character App Password
# from myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
# Base URL used for report links inside alerts (default http://127.0.0.1:<port>)
TISCAN_PUBLIC_URL=

# --- Ransomware monitor --------------------------------------------------------
# Countries refreshed in the background (ISO codes). JO + GCC by default.
RANSOMWARE_COUNTRIES=JO,SA,AE,KW,QA,BH,OM
RANSOMWARE_BACKGROUND_REFRESH=true

# --- Server --------------------------------------------------------------------
TISCAN_HOST=127.0.0.1
TISCAN_PORT=8787
# Required if you expose TIScan beyond localhost (e.g. for the Wazuh integration).
# Remote clients must send it in the X-API-Key header.
TISCAN_API_TOKEN=
CACHE_TTL_HOURS=6
HTTP_TIMEOUT=20
# Raise if you have a premium VirusTotal key
VT_RATE_PER_MIN=4
